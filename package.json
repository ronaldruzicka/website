{
	"name": "personal-portfolio",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json --watch",
		"codegen": "svelte-kit sync && panda codegen",
		"prepare": "bun run codegen && husky",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "prettier . --write",
		"format:check": "prettier . --check"
	},
	"devDependencies": {
		"@pandacss/dev": "1.9.1",
		"@sveltejs/adapter-auto": "7.0.1",
		"@sveltejs/enhanced-img": "^0.10.4",
		"@sveltejs/kit": "2.55.0",
		"@sveltejs/vite-plugin-svelte": "7.0.0",
		"husky": "^9.1.7",
		"oxlint": "1.59.0",
		"oxlint-tsgolint": "0.20.0",
		"prettier": "3.8.2",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "5.55.0",
		"svelte-check": "4.4.5",
		"typescript": "6.0.2",
		"vite": "8.0.2"
	},
	"dependencies": {
		"@hugeicons/core-free-icons": "4.0.0",
		"@hugeicons/svelte": "1.1.2"
	},
	"engines": {
		"node": ">=22",
		"bun": ">=1.3"
	}
}
