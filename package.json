{
	"name": "personal-portfolio",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --experimental-strip-types node_modules/vite/bin/vite.js dev",
		"build": "node --experimental-strip-types node_modules/vite/bin/vite.js build",
		"preview": "node --experimental-strip-types node_modules/vite/bin/vite.js preview",
		"check": "node --experimental-strip-types node_modules/@sveltejs/kit/svelte-kit.js sync && node --experimental-strip-types node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.check.json",
		"check:watch": "node --experimental-strip-types node_modules/@sveltejs/kit/svelte-kit.js sync && node --experimental-strip-types node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.check.json --watch",
		"codegen": "node --experimental-strip-types node_modules/@sveltejs/kit/svelte-kit.js sync && panda codegen",
		"prepare": "bun run codegen && husky",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "prettier . --write",
		"format:check": "prettier . --check"
	},
	"devDependencies": {
		"@pandacss/dev": "1.9.1",
		"@sveltejs/adapter-auto": "7.0.1",
		"@sveltejs/enhanced-img": "0.10.4",
		"@sveltejs/kit": "2.55.0",
		"@sveltejs/vite-plugin-svelte": "7.0.0",
		"@trivago/prettier-plugin-sort-imports": "6.0.2",
		"husky": "9.1.7",
		"oxlint": "1.59.0",
		"oxlint-tsgolint": "0.20.0",
		"prettier": "3.8.3",
		"prettier-plugin-svelte": "3.5.1",
		"svelte": "5.55.0",
		"svelte-check": "4.4.5",
		"typescript": "6.0.2",
		"vite": "8.0.2"
	},
	"dependencies": {
		"@hugeicons/core-free-icons": "4.0.0",
		"@hugeicons/svelte": "1.1.2"
	},
	"engines": {
		"node": ">=24",
		"bun": ">=1.3"
	}
}
